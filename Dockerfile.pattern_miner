# Cloud Run Job for mad_platform/agents/pattern_miner.py -- calls Gemini
# Flash via Vertex AI, same as every other judgment call in this
# pipeline, so this image is as light as scan-wcag-poller's: no
# Playwright/Chromium, no self-hosted model to bake in.
#
# Digest-pinned for the same reason as Dockerfile; keep all four images on
# the same base digest and move them together.
FROM python:3.14-slim@sha256:cad9a2c871761c413caa6fdd6441c783451e740a48aaeba60ae62a8b53525ef6

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY mad_platform ./mad_platform
COPY mine_patterns.py .

# Drop root -- see Dockerfile's copy of this comment.
RUN useradd --create-home --uid 1000 app
USER app

CMD ["python3", "mine_patterns.py"]
