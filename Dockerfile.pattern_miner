# Cloud Run Job for mad_platform/agents/pattern_miner.py -- calls Gemini
# Flash via Vertex AI, same as every other judgment call in this
# pipeline, so this image is as light as scan-wcag-poller's: no
# Playwright/Chromium, no self-hosted model to bake in.
FROM python:3.13-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY mad_platform ./mad_platform
COPY mine_patterns.py .

CMD ["python3", "mine_patterns.py"]
